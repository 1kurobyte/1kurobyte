# Options applied on top of `make ARCH=i386 tinyconfig` for the browser demo.
# The result is a ~1.6 MB kernel that boots to a shell in a few seconds
# inside v86: serial console, initramfs, ELF + scripts, /proc, /sys, devtmpfs,
# tmpfs, ptys and the syscalls a static i386 glibc binary expects.
CONFIG_PRINTK=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_KERNEL_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_SHMEM=y
CONFIG_UNIX98_PTYS=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_FILE_LOCKING=y
CONFIG_POSIX_TIMERS=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_SYSVIPC=y
CONFIG_AIO=y
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_CMOS=y
CONFIG_M686=y
CONFIG_NOHIGHMEM=y
CONFIG_HZ_100=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
# i386 glibc/readline still call the 32-bit time syscalls (pselect6, ...).
CONFIG_COMPAT_32BIT_TIME=y
CONFIG_EXPERT=y
# CONFIG_MODULES is not set
